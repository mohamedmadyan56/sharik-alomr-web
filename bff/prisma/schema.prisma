// ============================================================
//  منصة «شريك العمر» — SHARIK ALOMR
//  Prisma Schema — المخطط الكامل (كل المراحل)
//  قاعدة حاكمة: One Account = One Device
//  قاعدة أعمال: لا قيم مثبّتة في الكود — كل شيء في جداول
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================

NODE_ENV=development
HOST=127.0.0.1
PORT=4001
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/sharik_alomr_backend?schema=public
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
APP_URL=http://localhost:3000
WEB_SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars
WEB_COOKIE_NAME=sharik_web_session
SESSION_TTL_DAYS=7
SESSION_REMEMBER_DAYS=30
SESSION_IDLE_MINUTES=240
ADMIN_COOKIE_NAME=sharik_admin_session
ADMIN_SESSION_TTL_HOURS=12

# OTP — dev only
OTP_DEV_ECHO=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR_PER_PHONE=5
OTP_SMS_PROVIDER=dev

# Production SMS (required when OTP_SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Production cookies / proxy
# COOKIE_SECURE=true
# TRUST_PROXY=true

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Payments: dev | manual | stripe | paymob (production rejects dev)
PAYMENT_PROVIDER=dev
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Prometheus metrics (optional in dev, required in production)
METRICS_TOKEN=

# Media storage: local | s3
# local يخزّن في MEDIA_LOCAL_DIR (اربطه بـ volume في الإنتاج).
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_UPLOAD_MB=10
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=

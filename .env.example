# ─────────────────────────────────────────────────────────────
#  Sharik Alomr — production environment (copy to .env, never commit)
# ─────────────────────────────────────────────────────────────

# Public HTTPS origin used by cookies, Google OAuth, and sitemap.
PUBLIC_URL=https://sharik-alomr.com
SITE_URL=https://sharik-alomr.com

# PostgreSQL (docker compose service name: db)
POSTGRES_USER=sharik
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=sharik_alomr

# Web session signing — at least 32 random characters.
# Generate: openssl rand -base64 48
WEB_SESSION_SECRET=replace-with-at-least-32-random-characters

# OTP delivery. Production rejects the "dev" provider.
OTP_SMS_PROVIDER=twilio
OTP_DEV_ECHO=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Google sign-in (Web application OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_IDS=

# Payments: manual | stripe | paymob. Production rejects "dev".
PAYMENT_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_IFRAME_ID=
PAYMOB_HMAC_SECRET=

# Observability (Prometheus scrapes /metrics with this bearer token).
METRICS_TOKEN=replace-with-a-long-random-metrics-token
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-strong-grafana-password

# Session tuning (optional).
SESSION_TTL_DAYS=7
SESSION_REMEMBER_DAYS=30
SESSION_IDLE_MINUTES=240
ADMIN_SESSION_TTL_HOURS=12

# Media storage (BFF): local | s3
MEDIA_STORAGE=local
MEDIA_LOCAL_DIR=uploads
MEDIA_MAX_UPLOAD_MB=10
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=
